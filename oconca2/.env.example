# ==============================================================================
# OCONCA / CIMTRA - Variables de Entorno (Plantilla para Producción y Local)
# ==============================================================================
# Copia este archivo como .env y ajusta los valores antes de desplegar en producción.

# Modo de Django (1=Desarrollo, 0=Producción)
DJANGO_DEBUG=0

# Clave secreta única y segura para producción (generar una cadena aleatoria larga)
SECRET_KEY=cambiar-por-una-clave-secreta-larga-y-aleatoria-en-produccion

# Dominios o IPs permitidos separados por coma (ej. midominio.com,www.midominio.com,123.45.67.89)
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Configuración de Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=dj_ctl_comb
DB_USER=postgres
DB_PASSWORD=contrasena_super_segura_de_produccion

# ------------------------------------------------------------------------------
# Configuración de Seguridad SSL / HTTPS (Habilitar en producción con certificado)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# Contraseña inicial del usuario admin (si se inicializa la BD)
ADMIN_PASSWORD=admin123
